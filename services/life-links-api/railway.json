{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/life-links-api/Dockerfile"
  },
  "deploy": {
    "startCommand": "pnpm --filter @life-links/api start",
    "healthcheckPath": "/readyz",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}

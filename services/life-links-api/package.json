{
  "name": "@life-links/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @life-links/core build && pnpm --filter @life-links/demo build && tsc -b --force",
    "typecheck": "pnpm --filter @life-links/core build && tsc -b --force",
    "test": "pnpm --filter @life-links/core build && vitest run tests/server.test.ts tests/openapi-contract.test.ts tests/store-contract.test.ts",
    "test:contract": "vitest run tests/openapi-contract.test.ts",
    "test:postgres": "pnpm --filter @life-links/core build && vitest run tests/postgres.integration.test.ts",
    "dev": "pnpm run build && node dist/main.js",
    "start": "node dist/main.js",
    "migrate": "pnpm run build && node dist/migrate.js",
    "seed": "pnpm run build && node dist/seed.js",
    "demo:user": "pnpm --filter @life-links/core build && tsc -b --force && node dist/demo-user.js"
  },
  "dependencies": {
    "@life-links/core": "workspace:*",
    "cookie": "^1.0.2",
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "multer": "^2.1.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.0.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}

# Local disposable competition-fixture defaults. Never commit real credentials.
PORT=3002
HOST=127.0.0.1
APP_ENV=local
APP_VERSION=0.1.0
BUILD_SHA=local
CANONICAL_SOURCE_SHA=local
SOURCE_TREE_SHA256=unknown
BUILD_TIME=unknown

LIFE_LINKS_STORE=memory
SESSION_SECRET=replace-with-a-long-random-local-secret
SESSION_TTL_DAYS=14
COOKIE_SECURE=false

# Member-issued private accounts: each signed-in user can create limited links.
LIFE_LINKS_MEMBER_INVITATIONS_ENABLED=true

# Optional operator-code private accounts. Closed by default; enabling needs
# a secret 32-128 character URL-safe code, account cap 1-500 and exact UTC expiry.
# Never put the invitation in a public link, browser bundle or committed file.
LIFE_LINKS_REGISTRATION_ENABLED=false
LIFE_LINKS_REGISTRATION_INVITATION_CODE=
LIFE_LINKS_REGISTRATION_MAX_ACCOUNTS=
LIFE_LINKS_REGISTRATION_EXPIRES_AT=
QR_BASE_URL=http://127.0.0.1:3002
DEMO_SEED_PASSWORD=competition-local-password

AUTO_MIGRATE=true
AUTO_SEED=true
LIFE_LINKS_SEED_PROFILE=competition

LIFE_LINKS_COMPETITION_RESET_ENABLED=false
LIFE_LINKS_COMPETITION_ENVIRONMENT_ID=

TRUST_PROXY=false
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
ORIGIN_CHECK_ENABLED=false
ORIGIN_CHECK_ALLOW_MISSING=true
ALLOWED_ORIGINS=http://127.0.0.1:3002,http://127.0.0.1:5174

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=8
RATE_LIMIT_PUBLIC_MAX=180
RATE_LIMIT_MUTATION_MAX=90
RATE_LIMIT_CLAIM_MAX=30
RATE_LIMIT_BATCH_MAX=12

# Hosted challenge application overrides. Do not uncomment or deploy these
# invalid placeholders. APP_ENV=webmcp-challenge requires every value below to
# be replaced, including an exact HTTPS QR origin without a trailing slash and
# nonzero full lowercase 40/40/64-hex source identities.
# APP_ENV=webmcp-challenge
# NODE_ENV=production
# APP_VERSION=replace-with-release-version
# BUILD_SHA=replace-with-nonzero-full-lowercase-40-hex-public-build-sha
# CANONICAL_SOURCE_SHA=replace-with-nonzero-full-lowercase-40-hex-canonical-source-sha
# SOURCE_TREE_SHA256=replace-with-nonzero-full-lowercase-64-hex-release-tree-digest
# BUILD_TIME=replace-with-utc-build-time
# LIFE_LINKS_STORE=postgres
# DATABASE_URL=replace-with-fresh-challenge-postgres-url
# SESSION_SECRET=replace-with-a-fresh-long-random-session-secret
# COOKIE_SECURE=true
# QR_BASE_URL=https://lifelinks.vmosaic.com
# DEMO_SEED_PASSWORD=replace-with-a-fresh-judge-fixture-password
# AUTO_MIGRATE=true
# AUTO_SEED=false
# LIFE_LINKS_SEED_PROFILE=competition
# TRUST_PROXY=true
# HSTS_ENABLED=true
# ORIGIN_CHECK_ENABLED=true
# ORIGIN_CHECK_ALLOW_MISSING=false
# ALLOWED_ORIGINS=https://lifelinks.vmosaic.com,https://life-links-api-production-1398.up.railway.app
# LIFE_LINKS_COMPETITION_RESET_ENABLED=true
# LIFE_LINKS_COMPETITION_ENVIRONMENT_ID=replace-with-exact-fresh-environment-id
# RAILWAY_ENVIRONMENT_ID is provider-supplied and must equal the selected ID.

# Optional external calendars. Disabled for the disposable memory-store demo.
# Each enabled provider requires PostgreSQL, HTTPS on QR_BASE_URL's exact origin,
# its own registered application, and private runtime credential custody.
LIFE_LINKS_MICROSOFT_CALENDAR_ENABLED=false
LIFE_LINKS_GOOGLE_CALENDAR_ENABLED=false
# LIFE_LINKS_MICROSOFT_CLIENT_ID=
# LIFE_LINKS_MICROSOFT_REDIRECT_URI=https://lifelinks.vmosaic.com/api/calendar-providers/microsoft/callback
# LIFE_LINKS_MICROSOFT_CERTIFICATE_SHA256=
# LIFE_LINKS_MICROSOFT_PRIVATE_KEY_BASE64=
# LIFE_LINKS_GOOGLE_CLIENT_ID=
# LIFE_LINKS_GOOGLE_CLIENT_SECRET=
# LIFE_LINKS_GOOGLE_REDIRECT_URI=https://lifelinks.vmosaic.com/api/calendar-providers/google/callback
# LIFE_LINKS_CALENDAR_ENCRYPTION_KEY=
# The encryption key is base64-encoded 32-byte private material shared by this
# application's encrypted Calendar caches. Preserve it for existing connections.
# The public hosted values above name the existing Life Links deployment.
# Independent deployments must register and configure their own exact origin.
# The retained Railway origin supports existing links; HTML navigation moves to
# the canonical host before sign-in. Cookies stay host-only: sign in there once.
# Google uses Life Links' own Web OAuth client, not fixture/admin tokens or DWD.
# Google source support is implemented; own-client setup and live qualification
# remain pending. Do not enable a provider from these empty placeholders.

# Hosted qualification-runner inputs. These are supplied to E2E-CHALLENGE,
# not copied into the application service, and never contain real values here.
# LIFE_LINKS_CHALLENGE_BASE_URL=https://lifelinks.vmosaic.com
# LIFE_LINKS_CHALLENGE_EMAIL=replace-with-judge-email
# LIFE_LINKS_CHALLENGE_PASSWORD=replace-with-judge-password
# LIFE_LINKS_CHALLENGE_EXPECTED_BUILD_SHA=replace-with-nonzero-full-lowercase-40-hex-public-build-sha
# LIFE_LINKS_CHALLENGE_EXPECTED_CANONICAL_SOURCE_SHA=replace-with-nonzero-full-lowercase-40-hex-canonical-source-sha
# LIFE_LINKS_CHALLENGE_EXPECTED_SOURCE_TREE_SHA256=replace-with-nonzero-full-lowercase-64-hex-release-tree-digest

# Optional identity-only signup/sign-in; enable a comma-separated configured subset.
# Shared integration owner: docs/systems/provider_sign_in/Operations/Adoption.md.
# Sign-in and Calendar consent are separate. Never put credentials in browser code.
LIFE_LINKS_SIGN_IN_PROVIDERS=
# LIFE_LINKS_SIGN_IN_GOOGLE_CLIENT_ID=
# LIFE_LINKS_SIGN_IN_GOOGLE_CLIENT_SECRET=
# LIFE_LINKS_SIGN_IN_GOOGLE_REDIRECT_URI=https://lifelinks.vmosaic.com/api/auth/providers/google/callback
# LIFE_LINKS_SIGN_IN_MICROSOFT_CLIENT_ID=
# LIFE_LINKS_SIGN_IN_MICROSOFT_CLIENT_SECRET=
# LIFE_LINKS_SIGN_IN_MICROSOFT_TENANT=common
# LIFE_LINKS_SIGN_IN_MICROSOFT_REDIRECT_URI=https://lifelinks.vmosaic.com/api/auth/providers/microsoft/callback
# LIFE_LINKS_SIGN_IN_GITHUB_CLIENT_ID=
# LIFE_LINKS_SIGN_IN_GITHUB_CLIENT_SECRET=
# LIFE_LINKS_SIGN_IN_GITHUB_REDIRECT_URI=https://lifelinks.vmosaic.com/api/auth/providers/github/callback
# LIFE_LINKS_SIGN_IN_FACEBOOK_CLIENT_ID=
# LIFE_LINKS_SIGN_IN_FACEBOOK_CLIENT_SECRET=
# LIFE_LINKS_SIGN_IN_FACEBOOK_GRAPH_API_VERSION=replace-with-qualified-version
# LIFE_LINKS_SIGN_IN_FACEBOOK_REDIRECT_URI=https://lifelinks.vmosaic.com/api/auth/providers/facebook/callback
# Apple requires eligible primary app/Services ID/key and secure cookies for form_post.
# LIFE_LINKS_SIGN_IN_APPLE_CLIENT_ID=
# LIFE_LINKS_SIGN_IN_APPLE_TEAM_ID=
# LIFE_LINKS_SIGN_IN_APPLE_KEY_ID=
# LIFE_LINKS_SIGN_IN_APPLE_PRIVATE_KEY=
# LIFE_LINKS_SIGN_IN_APPLE_REDIRECT_URI=https://lifelinks.vmosaic.com/api/auth/providers/apple/callback
# ChatGPT stays disabled without an approved OpenAI website identity client.
# LIFE_LINKS_SIGN_IN_CHATGPT_APPROVED=true
# LIFE_LINKS_SIGN_IN_CHATGPT_CLIENT_ID=
# LIFE_LINKS_SIGN_IN_CHATGPT_TOKEN_AUTH_METHOD=none
# LIFE_LINKS_SIGN_IN_CHATGPT_CLIENT_SECRET=only-for-approved-client_secret_basic
# LIFE_LINKS_SIGN_IN_CHATGPT_REDIRECT_URI=https://lifelinks.vmosaic.com/api/auth/providers/chatgpt/callback

# Public signup creates owners only after the selected proof. Native email and
# phone options remain unavailable until their production transport is configured.
# These values are application/server inputs, not hosted runner credentials.
LIFE_LINKS_EMAIL_VERIFICATION_ENABLED=false
# LIFE_LINKS_EMAIL_VERIFICATION_GATEWAY_BASE_URL=
# LIFE_LINKS_EMAIL_VERIFICATION_GATEWAY_BEARER_TOKEN=
# LIFE_LINKS_EMAIL_VERIFICATION_SENDER_MAILBOX=
# LIFE_LINKS_EMAIL_VERIFICATION_APP_DISPLAY_NAME=LifeLinks
# LIFE_LINKS_EMAIL_VERIFICATION_MAX_SENDS_PER_DAY=100
# LIFE_LINKS_EMAIL_VERIFICATION_MAX_SENDS_PER_MONTH=3000
# Email uses the existing Agent Communications send-only application connection.
# Set the exact admitted HTTPS gateway origin and its dedicated application bearer;
# never use the coordinator/mailbox-read bearer or Microsoft provider credentials.
# Set SENDER_MAILBOX to the gateway-bound sender (currently agents@vmosaic.com),
# not an unprovisioned alias. The gateway owns provider custody and delivery state.

LIFE_LINKS_PHONE_VERIFICATION_ENABLED=false
# LIFE_LINKS_PHONE_VERIFICATION_TELNYX_API_KEY=
# LIFE_LINKS_PHONE_VERIFICATION_FROM_E164=
# LIFE_LINKS_PHONE_VERIFICATION_MESSAGING_PROFILE_ID=
# LIFE_LINKS_PHONE_VERIFICATION_APP_DISPLAY_NAME=LifeLinks
# LIFE_LINKS_PHONE_VERIFICATION_ALLOWED_REGIONS=US,CA
# LIFE_LINKS_PHONE_VERIFICATION_MAX_SENDS_PER_DAY=
# LIFE_LINKS_PHONE_VERIFICATION_MAX_SENDS_PER_MONTH=
# LIFE_LINKS_PHONE_VERIFICATION_MAX_COST_PER_SMS_USD=
# LIFE_LINKS_PHONE_VERIFICATION_MAX_SPEND_PER_DAY_USD=
# LIFE_LINKS_PHONE_VERIFICATION_MAX_SPEND_PER_MONTH_USD=
# LIFE_LINKS_PHONE_CREDENTIAL_SECRET=
# Phone identity fingerprints use this durable >=32-byte secret.
# Preserve it across session/provider secret rotations; replacement needs the
# owned credential migration. Sender/SMS activation also needs an approved sender
# bound to this exact Telnyx profile, profile country restrictions matching the
# allowed regions, consent and reviewed send/spend caps. Runtime validates actual
# US/Canada country metadata; +1 alone does not identify either country.
# MAX_COST_PER_SMS_USD covers the whole message, every part and carrier fees;
# local code verification adds no remote verification fee. Number/account recurring
# charges remain separate commitments. Empty limits do not authorize activation.
# Apple PRIVATE_KEY above is literal multiline PEM. The repository's line-based
# env helper cannot read it; inject its private file through the server custody
# lane described in docs/systems/life_links/Operations/Provider_Sign_In.md.

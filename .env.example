# Local in-memory development defaults. Never commit real credentials.
PORT=3002
HOST=0.0.0.0
LIFE_LINKS_STORE=memory
SESSION_SECRET=replace-with-a-long-random-local-secret
SESSION_TTL_DAYS=14
COOKIE_SECURE=false
QR_BASE_URL=http://127.0.0.1:3002
DEMO_SEED_PASSWORD=replace-with-a-local-demo-password
AUTO_MIGRATE=true
AUTO_SEED=true
TRUST_PROXY=false
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
ORIGIN_CHECK_ENABLED=false
ORIGIN_CHECK_ALLOW_MISSING=true
ALLOWED_ORIGINS=http://127.0.0.1:3002,http://127.0.0.1:5174
RATE_LIMIT_ENABLED=true

    "native-build/canvas-skia-materials.lock.json",
    "native-build/patches/0001-backport-draw-image-source-napi-3.12.patch",
    "native-build/qualify-native.mjs",
    "native-build/run-offline-build.mjs",
    "native-build/smoke-wrapper.mjs",
    "native-build/verify-materials.mjs",
    "native-build/verify-package.mjs",

{
  "name": "@life-links/demo",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "contract:generate": "pnpm --workspace-root exec vite-node --script apps/life-links-demo/tools/webmcp-contract-snapshot.ts generate",
    "contract:check": "pnpm --workspace-root exec vite-node --script apps/life-links-demo/tools/webmcp-contract-snapshot.ts check",
    "dev": "pnpm --filter @life-links/core build && vite --host 127.0.0.1 --port 5174",
    "build": "pnpm --filter @life-links/core build && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "pnpm --filter @life-links/core build && vitest run src/api.test.ts src/domain.test.ts src/webmcpCompatibility.test.ts src/workspace/controller.test.ts src/workspace/editorSession.test.ts src/owner/LifeLinkTree.test.ts src/agent/activity.test.ts src/agent/browserWebMcpHost.test.ts src/agent/toolHandlers.test.ts src/agent/usePageToolRegistration.test.ts e2e/support/challengeExpectedIdentity.test.ts",
    "test:e2e": "playwright test e2e/hosted-smoke.spec.ts",
    "test:e2e:rich": "pnpm build && playwright test -c playwright.rich.config.ts e2e/rich-body-editor.spec.ts",
    "test:e2e:webmcp:local": "pnpm build && playwright test -c playwright.rich.config.ts e2e/webmcp-local.spec.ts --project=desktop-chromium",
    "test:e2e:webmcp:real": "playwright test -c playwright.webmcp-real.config.ts e2e/webmcp-real-host.spec.ts --project=chrome-webmcp-native",
    "test:e2e:challenge": "playwright test -c playwright.challenge.config.ts e2e/challenge-loop.spec.ts --project=challenge-chromium",
    "test:e2e:workflow": "playwright test e2e/workflow-smoke.spec.ts"
  },
  "dependencies": {
    "@life-links/core": "workspace:*",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-task-item": "^3.22.5",
    "@tiptap/extension-task-list": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@tiptap/suggestion": "^3.22.5",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "ajv": "6.12.6",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.4",
    "webmcp-types": "0.1.5"
  }
}
